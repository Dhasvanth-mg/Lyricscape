# --- Local-first configuration -------------------------------------------
# Lyricscape runs fully offline by default: no Supabase, no Vercel, no R2.
# Everything below is optional. Copy to .env.local to override.

NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Secret used to sign session cookies, guest tokens and upload/video URLs.
# A random one is generated into .data/secret.key if this is empty.
LYRICSCAPE_SECRET=

# Where the local data store (db.json + uploaded party media + rendered recaps) lives.
LYRICSCAPE_DATA_DIR=.data

# Upload limit for party media (MB)
MAX_UPLOAD_MB=250

# Feature switches (all default to on locally)
ENABLE_PARTY_RECAP_EXPORT=true
ENABLE_LOCATION_HISTORY=true

# Optional basemap style for the Music Map (MapLibre style JSON URL).
# Empty = offline basemap (Natural Earth land + graticule).
NEXT_PUBLIC_MAP_STYLE_URL=

# --- Media worker (pnpm worker) ------------------------------------------
# Defaults work locally (the secret is derived from .data/secret.key).
# WORKER_BASE_URL=http://127.0.0.1:3000
# MEDIA_WORKER_SECRET=
# FFMPEG_PATH=      # defaults to the bundled ffmpeg-static
# FFPROBE_PATH=
# RECAP_FONT=       # .ttf used for recap captions; defaults to a common system font

# --- Optional: real Spotify (PKCE, public client: no secret) ---------------
# You can paste the Client ID in Settings instead of using this variable.
# Register this exact redirect URI in your Spotify app (127.0.0.1, not localhost):
#   http://127.0.0.1:3000/spotify/callback
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=

# --- Deferred (cloud) integrations: intentionally unused for now ---------
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# R2_ACCOUNT_ID= ...

# --- Optional: AI reading of lyric themes (off unless you set a key AND switch it on in Settings) --
# Any OpenAI-compatible gateway works; OmniRoute (https://github.com/diegosouzapw/OmniRoute) is the default target.
# Only title, artist, genre tags and an excerpt of the lyrics are sent, once per song; the answer is cached on the device.
# OMNIROUTE_API_KEY=
# OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
# LYRICSCAPE_AI_MODEL=auto
