{
 "schema": "lyricscape.scene-data/1",
 "style": "Nocturne",
 "slug": "nocturne",
 "code": "NOC",
 "layerOrder": [
  "darkness ground (tinted)",
  "far plane (bokeh, horizon)",
  "room or window silhouettes",
  "light source and pool",
  "weather (rain plane, dust, snow, fog)",
  "text",
  "grain whisper"
 ],
 "limits": {
  "scale": "Silhouettes only at frame edges (max 25% of area).",
  "safe": "Text inside the light pool and central 80%; rain masked around text.",
  "complexity": "Max 3 layers besides darkness and text.",
  "colour": "One light colour.",
  "motion": "One moving layer at a time besides text.",
  "material": "Glass layers only in window scenes."
 },
 "invalid": [
  {
   "this": "Two light sources",
   "never_with": "any",
   "because": "Identity rule."
  },
  {
   "this": "Rain plane",
   "never_with": "over the text box",
   "because": "Readability."
  },
  {
   "this": "Heavy grain (over 0.05)",
   "never_with": "any",
   "because": "Celluloid territory."
  },
  {
   "this": "Beat-driven motion",
   "never_with": "any above 1% gain",
   "because": "Calm rule."
  },
  {
   "this": "Interface elements",
   "never_with": "screen glow",
   "because": "Screenlife territory."
  },
  {
   "this": "Candle flicker",
   "never_with": "over 1 Hz",
   "because": "Flash and calm rule."
  }
