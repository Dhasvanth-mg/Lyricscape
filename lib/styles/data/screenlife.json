{
 "schema": "lyricscape.scene-data/1",
 "style": "Screenlife",
 "slug": "screenlife",
 "code": "SCR",
 "layerOrder": [
  "room or environment plate (ENV)",
  "device shadow",
  "device frame (FRM)",
  "wallpaper (PRC wallpaper, only lock and desktop)",
  "UI sheet: kit state (UIK) with earlier lines",
  "active field with lyric and caret (REV)",
  "overlays: notifications, stickers, reactions (PRP)",
  "glass reflection and smudge (TEX)",
  "post: grain, focus blur, motion blur, CRT scan for terminals"
 ],
 "limits": {
  "scale": "Lyric x-height floors as in typography; device never smaller than 55% of the frame height in landscape; notifications never larger than the lyric field.",
  "safe": "Lyric box in the title-safe 84% x 80% and outside the bottom 14% player-chrome zone; overlays never intersect the lyric box (layout solver pushes them to the opposite half).",
  "complexity": "Max 6 visible UI widgets besides the lyric field; max 1 overlay; max 2 devices.",
  "colour": "One theme per device world; accent from cover; stickers use accent or complementary only; room plate tinted by the theme spill.",
  "motion": "Only one of camera push, whip pan or scroll per 600 ms window; no camera move during the last 300 ms of a line's typing.",
  "material": "CRT plates only with terminal and old desktop kits; glass smudge never with CRT; hand silhouette never with desktop monitors."
 },
 "invalid": [
  {
   "this": "Light theme",
   "never_with": "bloom or glow post",
   "because": "Blows out white UI (observed)."
  },
  {
   "this": "Terminal kit",
   "never_with": "stickers or reactions",
   "because": "Different device worlds."
  },
  {
   "this": "Post and caption",
   "never_with": "cover crop altered or recoloured",
   "because": "Cover must be shown unmodified (Spotify artwork policy)."
  },
  {
   "this": "Any kit",
   "never_with": "invented third-party messages",
   "because": "Fabricated conversation rule."
  },
  {
   "this": "Two Screens (C5)",
   "never_with": "portrait small mobile with both full devices",
   "because": "Fields become too small; use the receiver banner instead."
  },
  {
   "this": "Hindi, Tamil, Arabic text",
   "never_with": "typo model",
   "because": "No typos inside complex scripts."
  },
  {
   "this": "Code editor",
   "never_with": "default for electronic songs",
   "because": "Only when chosen or the lyric is about code."
  }
 ],
