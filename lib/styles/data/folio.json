 ],
 "limits": {
  "scale": "Pull quote and headline from the template's size table; body 1.4-1.8% of frame.",
  "safe": "Lyric slot inside central 80% after framing; collision type never enters the lyric clear zone.",
  "complexity": "Max 3 columns of body visible at once in the frame.",
  "colour": "Ink plus one spot colour; plates full colour only in the art book.",
  "motion": "One camera move per line at most.",
  "material": "Halftone plates only on newsprint; coated paper only in the art book."
 },
 "invalid": [
  {
   "this": "Body text",
   "never_with": "invented copy",
   "because": "Secondary text must be the song itself."
  },
  {
   "this": "Drop caps",
   "never_with": "Devanagari, Tamil, Arabic",
   "because": "Convention and shaping."
  },
  {
   "this": "Italic emphasis",
   "never_with": "scripts without italics",
   "because": "Use ink darkening."
  },
  {
   "this": "Loud collisions",
   "never_with": "over the lyric",
   "because": "Readability rule."
  },
  {
   "this": "Real mastheads",
   "never_with": "any",
   "because": "Rights."
  },
  {
   "this": "Plates",
   "never_with": "altered cover art when shown as the cover",
   "because": "Artwork policy; derived plates must not pose as the cover."
  }
 ],
