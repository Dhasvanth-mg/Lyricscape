{
 "schema": "lyricscape.scene-data/1",
 "style": "Paper Theatre",
 "slug": "paper-theatre",
 "code": "PTR",
 "layerOrder": [
  "ground gradient (light rig)",
  "far layer (tracing paper, lightest)",
  "middle set",
  "near set",
  "figures and moving pieces",
  "props (strings, bunting, falling paper)",
  "lyric (card, banner or cut layer)",
  "frame (arch, window, book, lantern, rollers)",
  "post: paper fibre on ground, fog on far layers"
 ],
 "limits": {
  "scale": "Far pieces 10-30% of height, middle 20-45%, near 30-60%; figures 8-25%; no piece over 40% except frames and C6.",
  "safe": "Lyric on the brightest ground region and inside the frame opening's central 80%; no piece may cover more than 8% of the lyric box (overlap test).",
  "complexity": "Max 20 pieces on stage; max 7 layers.",
  "colour": "One ground hue per stage; one tissue accent; pieces black or set paper only.",
  "motion": "Max 3 moving elements (intensity tier caps); no piece crosses the lyric box while a word is being revealed.",
  "material": "Tissue only for light-transmitting pieces; tracing paper only on the far layer; kraft and black card never on the same layer."
 },
 "invalid": [
  {
   "this": "Two sets",
   "never_with": "same stage",
   "because": "Breaks the world (only panorama seams join sets)."
  },
  {
   "this": "Cut letters",
   "never_with": "long lines over 3 words",
   "because": "Becomes unreadable; use a printed card."
  },
  {
   "this": "Lantern composition",
   "never_with": "more than 2 figures",
   "because": "Too small to read."
  },
  {
   "this": "Fairground light cycle",
   "never_with": "quiet or sad identity",
   "because": "Wrong mood."
  },
  {
   "this": "Snow village",
   "never_with": "religious symbols",
   "because": "Excluded everywhere."
  },
  {
   "this": "Tissue accent",
   "never_with": "behind the lyric",
   "because": "Coloured light lowers contrast unpredictably."
  }
 ],
