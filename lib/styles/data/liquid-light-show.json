 "limits": {
  "scale": "Letter masks cap height 10-16%.",
  "safe": "Slide inside central 80-84%.",
  "complexity": "Max 2 dishes.",
  "colour": "Max 4 dyes per dish; 2 shared across dishes; luminance sum capped.",
  "motion": "One gesture at a time per dish.",
  "material": "Oil presets never with marbling presets in the same projection."
 },
 "invalid": [
  {
   "this": "Two dishes",
   "never_with": "4 dyes each",
   "because": "Mud and white-out."
  },
  {
   "this": "Hue cycling",
   "never_with": "faster than 1 cycle per 4 s",
   "because": "Flash and cliché."
  },
  {
   "this": "Letter masks",
   "never_with": "lines over 3 words",
   "because": "Letters too small to show fluid."
  },
  {
   "this": "Monochrome palette",
   "never_with": "water and dye",
   "because": "Ink's territory."
  },
  {
   "this": "Squeeze on beat",
   "never_with": "beat grid under 0.5 confidence",
   "because": "Would misfire."
  },
  {
   "this": "Black intro",
   "never_with": "any",
   "because": "Observed bug; intro starts lit."
  }
