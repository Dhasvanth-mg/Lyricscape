 "layer_order": [
  "grid background (register ground: black, page black, or paper)",
  "subject cells (character pass over a subject map)",
  "subject motion channel",
  "routed calligram letters",
  "band mask",
  "band text and cursor",
  "persistence / ink spread",
  "post: scan and curve (ASCII), raster (teletext), paper fibre (typewriter)"
 ],
 "invalid": [
  {
   "this": "Teletext register",
   "never_with": "cover-derived hues",
   "because": "Breaks the eight-colour medium."
  },
  {
   "this": "Fine grid",
   "never_with": "outputs under 600 px tall",
   "because": "Unreadable on phones."
  },
  {
   "this": "Devanagari, Tamil, Arabic",
   "never_with": "per-cell migration",
   "because": "Clusters cannot be split."
  },
  {
   "this": "Fire subject",
   "never_with": "density pulse",
   "because": "Two flicker sources exceed the flash budget."
  },
  {
   "this": "Calligram",
   "never_with": "estimated word timing",
   "because": "Hook migration would claim a timing that is a guess (it starts at line end instead)."
  },
  {
   "this": "Typewriter register",
   "never_with": "phosphor bloom",
   "because": "Paper does not glow."
  }
 ],
 "limits": {
  "scale": "Cell size from the three grid resolutions only; band rows 1-3; subject occupies 50-80% of the grid area.",
  "safe": "Band inside 4-cell margins and out of the subject's declared focal box; bottom 14% kept clear in the app stage.",
  "complexity": "One subject per scene; max 24 routed letters at once.",
  "colour": "One palette per register; teletext only the eight colours; 1-bit only two.",
  "motion": "One moving subject part at a time; migration and density pulse never in the same second.",
  "material": "Paper only with typewriter and 1-bit; scanlines only with ASCII; raster only with teletext."
 }
}
