 ],
 "limits": {
  "scale": "Forms snap to module multiples; dominant form 2-8 modules; type from the modular scale.",
  "safe": "Type block in its layout slot, which forms may never enter (hard exclusion mask); 6% outer margin.",
  "complexity": "Max 2 shape families; max 120 forms.",
  "colour": "Max 3 inks; type always the darkest ink (or paper on negative).",
  "motion": "Max 4 steps per second per form; all steps share the trigger source.",
  "material": "Riso grain only on uncoated paper systems; negative print has no paper texture."
 },
 "invalid": [
  {
   "this": "Rotated edge",
   "never_with": "Devanagari, Tamil, Arabic",
   "because": "Not a convention for these scripts here; poor reading."
  },
  {
   "this": "Scatter on grid",
   "never_with": "estimated words",
   "because": "Word modules would claim timing."
  },
  {
   "this": "Waves",
   "never_with": "high contrast inks while moving",
   "because": "Op-art flicker."
  },
  {
   "this": "Negative print",
   "never_with": "riso grain",
   "because": "Light on dark is not paper ink."
  },
  {
   "this": "Any form",
   "never_with": "the type slot",
   "because": "Hard exclusion."
  },
  {
   "this": "Beat hits",
   "never_with": "beat grid under 0.5 confidence",
   "because": "Would mark wrong downbeats."
  }
 ],
